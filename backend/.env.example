# ============================================================
# Smarty AI – Environment Configuration
# ============================================================
# Copy this file to .env and fill in real values.
# NEVER commit .env with real secrets!
# ============================================================

# ─── Environment ────────────────────────────────────────────
# development | test | production
ENVIRONMENT=development

# ─── Database ───────────────────────────────────────────────
# Neon PostgreSQL (production)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
# SQLite fallback (development only)
# DATABASE_URL=sqlite:///./smarty_neural_core.db

# Connection pool tuning (production)
# DB_POOL_SIZE=10
# DB_MAX_OVERFLOW=20
# DB_POOL_TIMEOUT=30
# DB_POOL_RECYCLE=300

# ─── Authentication ─────────────────────────────────────────
# REQUIRED in production – generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=
SECRET_KEY=
ADMIN_PASSWORD=

# ─── Google OAuth 2.0 ───────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── Google Gemini API ──────────────────────────────────────
GEMINI_API_KEY=

# ─── CORS ───────────────────────────────────────────────────
# Comma-separated allowed origins. NEVER use * in production.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173

# ─── SMTP / Email ───────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@smarty.ai

# ─── Vercel / Deployment ────────────────────────────────────
# VERCEL_URL is auto-set by Vercel; used for redirect URIs
# FRONTEND_URL=https://your-app.vercel.app

# ─── Rate Limiting ──────────────────────────────────────────
# RATE_LIMIT_DEFAULT=60/minute
