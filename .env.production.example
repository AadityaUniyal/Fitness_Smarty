# ============================================================
# Smarty AI – Production Environment Template
# ============================================================
# These environment variables must be set in your deployment
# platform (Vercel, Docker, etc.) for production.
# ============================================================

# ─── Required ───────────────────────────────────────────────
ENVIRONMENT=production
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
JWT_SECRET_KEY=  # python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=      # Same as JWT_SECRET_KEY
ADMIN_PASSWORD=
GEMINI_API_KEY=

# ─── CORS (production origins only) ────────────────────────
CORS_ORIGINS=https://your-app.vercel.app,https://your-domain.com

# ─── Google OAuth 2.0 ───────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── Email (SMTP) ───────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@smarty.ai

# ─── Frontend (Vite build-time) ─────────────────────────────
VITE_API_URL=https://your-backend.vercel.app
VITE_GOOGLE_CLIENT_ID=
