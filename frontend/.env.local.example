# Frontend Environment Variables - Smarty AI
# Copy to .env.local and fill in your actual values.

# Backend API URL (FastAPI server)
VITE_API_URL=http://localhost:8000

# Gemini API keys belong in backend/.env as GEMINI_API_KEY.
# Do not expose Gemini secrets with VITE_ variables.

# Clerk Auth (optional - leave empty to run in dev mode without auth)
# VITE_CLERK_PUBLISHABLE_KEY=pk_test_...
