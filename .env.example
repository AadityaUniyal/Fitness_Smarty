# Smarty AI Environment Variables Template
# Copy this file to .env at the root or within the backend directory and configure the values

# === BACKEND CONFIGURATION ===
# Google Gemini API key (get from https://aistudio.google.com/apikeys)
GEMINI_API_KEY=your_gemini_api_key_here

# Database connection URL (SQLite for local dev, PostgreSQL for production)
DATABASE_URL=sqlite:///./smarty_neural_core.db

# Secret key for JWT auth (generate with: python -c "import secrets; print(secrets.token_hex(32))")
JWT_SECRET_KEY=your_secret_key_here

# Initial password for default admin account (if unset, a random password is generated at seed time)
ADMIN_PASSWORD=your_admin_password_here

# Runtime environment (development / production)
ENVIRONMENT=development

# Comma-separated list of allowed CORS origins
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173

# === SMTP MAIL CONFIGURATION (FOR FEEDBACK MAILER) ===
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-sender-email@gmail.com
SMTP_PASSWORD=your-sender-email-app-password
SMTP_FROM_EMAIL=your-sender-email@gmail.com
SMTP_TO_EMAIL=your-recipient-email@gmail.com

# === FRONTEND CONFIGURATION ===
# Vite port configurations (optional)
VITE_API_URL=http://localhost:8000
